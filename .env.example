# Public URL of the site (payment return pages, OAuth callbacks). No trailing slash.
SITE_URL=https://www.nirakarmedia.com

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_... keys until you go live.
# Subscriptions must be enabled on your account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay (Dashboard > Account & Settings > Webhooks), for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Optional: contact-form leads and payment alerts are POSTed here as JSON
# (e.g. a Zapier/Make/Slack/Google Apps Script webhook). Otherwise they are logged.
CONTACT_WEBHOOK_URL=

# Shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=hello@nirakarmedia.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Client portal (/login, /portal, /admin) ----
# Postgres connection string (Neon, Supabase, etc.). Leave empty locally to use an
# embedded database in ./.data/pglite (not for production on Vercel).
DATABASE_URL=
# 32 random bytes, base64. Encrypts stored YouTube/Instagram tokens. Generate with:
#   openssl rand -base64 32
# Never change it after clients connect accounts, or they must reconnect.
ENCRYPTION_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/sync. Any long random string.
CRON_SECRET=
# First admin login, created by `npm run seed`
ADMIN_EMAIL=admin@nirakarmedia.com
ADMIN_PASSWORD=

# YouTube: Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram: Meta developer app with Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Local testing over plain http on a non-localhost address only
# INSECURE_COOKIES=1

# Email notifications (resend.com). Without the key, emails are logged in Admin > Emails but not sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM=Nirakar Media <hello@nirakarmedia.com>
# Where client replies are sent (comma-separated). Default: every admin login.
TEAM_EMAIL=

# AI Studio (Admin > AI): Claude drafts ideas, scripts and captions. Key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: a different Claude model. Defaults to claude-opus-5-5.
AI_MODEL=
